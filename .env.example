# Copy to .env. Every variable is optional except GOOGLE_API_KEY for the Gemini paths.

GOOGLE_API_KEY=
# Must have a price in src/video_benchmark/pricing.py (gemini-2.5-flash, gemini-2.5-flash-lite).
GEMINI_MODEL=gemini-2.5-flash

# Path 2 frame budget: frames sampled evenly, frames kept for synthesis (scene-aware),
# and how many of the kept frames are attached as images to the synthesis call.
VISION_SAMPLE_KEYFRAMES=24
FRAME_SELECT_BUDGET=16
GEMINI_SYNTH_MAX_IMAGES=8
SCENE_DETECT_THRESHOLD=20.0

# Path 3: local models (pip install -e ".[oss]" plus llama-cpp-python).
OSS_VISION_REPO_ID=unsloth/Qwen2.5-VL-3B-Instruct-GGUF
OSS_VISION_REPO_FILENAME=Qwen2.5-VL-3B-Instruct-Q4_K_M.gguf
OSS_VISION_MMPROJ_REPO_FILENAME=mmproj-F16.gguf
OSS_VISION_CHAT_FORMAT=qwen2.5-vl
OSS_SYNTH_REPO_ID=Qwen/Qwen2.5-7B-Instruct-GGUF
OSS_SYNTH_REPO_FILENAME=qwen2.5-7b-instruct-q3_k_m.gguf
OSS_SYNTH_MAX_TOKENS=2048
OSS_FRAME_CAPTION_MAX_CHARS=240
# whisperx (diarized; needs HF_TOKEN), whisper, or gemini (shares Path 2's paid transcript).
OSS_ASR=whisperx
HF_TOKEN=
WHISPER_MODEL=small
WHISPERX_MODEL=small.en
WHISPERX_DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
WHISPERX_MIN_SPEAKERS=2
# WHISPERX_NUM_SPEAKERS=6

# Path 4: fal (pip install -e ".[fal]"). Enabled when a key is set.
FAL_KEY=

# Path 5: Amazon Nova on Bedrock (pip install -e ".[bedrock]"). Enabled when credentials are set.
# NOVA_MODEL_ID=amazon.nova-pro-v1:0
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# Or a Bedrock API key:
# BEDROCK_API_KEY=

# Label exported runs.
# BENCHMARK_TUNE_TAG=baseline
# Default paths for run-benchmark (1, 1L, 2, 3, 4, 5).
# BENCHMARK_PATHS=1,2

# Video-MME (pip install -e ".[videomme]"): sample size, seed, paths, frame budget.
# VIDEOME_N=30
# VIDEOME_SEED=42
# VIDEOME_PATHS=1,2
# VIDEOME_VISION_SAMPLE_KEYFRAMES=32
# VIDEOME_FRAME_SELECT_BUDGET=24
