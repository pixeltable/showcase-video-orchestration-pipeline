GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OSS_BACKEND=llama_cpp
OSS_VISION_REPO_ID=unsloth/Qwen2.5-VL-3B-Instruct-GGUF
OSS_VISION_REPO_FILENAME=Qwen2.5-VL-3B-Instruct-Q4_K_M.gguf
OSS_VISION_MMPROJ_REPO_FILENAME=mmproj-F16.gguf
OSS_VISION_CHAT_FORMAT=qwen2.5-vl
OSS_SYNTH_REPO_ID=Qwen/Qwen2.5-7B-Instruct-GGUF
OSS_SYNTH_REPO_FILENAME=qwen2.5-7b-instruct-q3_k_m.gguf
OSS_SYNTH_MAX_TOKENS=2048
OSS_FRAME_CONTEXT_MAX_ENTRIES=16
OSS_FRAME_INSIGHT_MAX_CHARS=240
WHISPER_MODEL=small
OSS_ASR=whisperx

# WhisperX diarization (Path 3 default; requires pip install -e ".[whisperx]" and HF_TOKEN)
WHISPERX_MODEL=small.en
WHISPERX_DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
WHISPERX_MIN_SPEAKERS=2
# WHISPERX_NUM_SPEAKERS=6
HF_TOKEN=

# Audio splitting: full (one chunk) | duration (fixed windows) | max_size (byte budget)
AUDIO_SPLIT_MODE=full
AUDIO_CHUNK_DURATION_SEC=10.0
AUDIO_CHUNK_MAX_BYTES=25165824

# Vision frame budget and Gemini batching (Path 2)
MAX_VISION_KEYFRAMES=12
VISION_SAMPLE_KEYFRAMES=24
# Fallback only when sample count is unset; sampling uses num_frames (duration-agnostic)
VISION_REFERENCE_DURATION_SEC=260.0
FRAME_CONTEXT_MAX_ENTRIES=16
FRAME_SELECT_BUDGET=16
SCENE_AWARE_FRAMES=1
GEMINI_VISION_MODE=per_frame
GEMINI_VISION_BATCH_SIZE=6
# Keyframe images re-attached to Path 2 synthesis (multimodal)
GEMINI_SYNTH_MAX_IMAGES=8

# Path 4 — Native fal (pip install -e ".[fal]"; set FAL_KEY)
# ENABLE_FAL=1
FAL_KEY=
# FAL_VIDEO_URL=https://...   # optional public URL; else local file is uploaded
# FAL_DETAILED_ANALYSIS=0

# Path 5 — Native Nova / Bedrock (pip install -e ".[bedrock]")
# ENABLE_NOVA=1
# NOVA_MODEL_ID=amazon.nova-pro-v1:0
# NOVA_VIDEO_S3_URI=s3://bucket/key.mp4   # optional; default uses local bytes (<=25MB)
# NOVA_INPUT_USD_PER_1M=0.06
# NOVA_OUTPUT_USD_PER_1M=0.24
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# Or Bedrock API key:
# AWS_BEARER_TOKEN_BEDROCK=

# Tag exported runs when tuning (lab only — see docs/LAB_RESULTS.md)
# BENCHMARK_TUNE_TAG=baseline

# Optional path selection (default 1,2):
# BENCHMARK_PATHS=1,2

SCENE_DETECT_THRESHOLD=20.0
MIN_SEGMENT_DURATION=1.0
SEGMENT_FALLBACK_WINDOW_SEC=10.0
BENCHMARK_RESET=0

# Optional Ollama fallback (set OSS_BACKEND=ollama):
# OSS_VISION_MODEL=llava:13b
# OLLAMA_HOST=http://localhost:11434

# Fair ASR comparison for Path 3 (uses gemini_transcript_lines instead of Whisper/WhisperX):
# OSS_ASR=gemini

# Video-MME dev slice (pip install -e ".[videomme]"; ./scripts/run_videomme_dev.sh)
# VIDEOME_DEV_N=30
# VIDEOME_DEV_SEED=42
