# Recipe: Path 2, orchestrated Gemini. Copy into .env.
# run-benchmark --paths 2 --reset

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Frames sampled evenly, frames kept near scene cuts, images attached at synthesis.
VISION_SAMPLE_KEYFRAMES=24
FRAME_SELECT_BUDGET=16
GEMINI_SYNTH_MAX_IMAGES=8
SCENE_DETECT_THRESHOLD=20.0
